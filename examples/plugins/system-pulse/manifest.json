{
  "id": "dev.example.system-pulse",
  "name": "System Pulse",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.0",
  "description": "Пример плагина: показывает загрузку CPU/RAM, счётчик нажатий в хранилище, уведомления и активность в компактной панели.",
  "author": "Desktop Island",
  "entry": "index.html",
  "permissions": ["system.read", "notifications", "storage", "activity"],
  "card": { "title": "System Pulse", "height": 200 },
  "settings": [
    { "key": "greeting", "type": "string", "label": "Текст приветствия", "default": "Привет из плагина!" },
    { "key": "interval", "type": "select", "label": "Обновление", "default": "5 с", "options": ["2 с", "5 с", "10 с"] },
    { "key": "showActivity", "type": "boolean", "label": "Показывать CPU в компактной панели", "default": false }
  ]
}
